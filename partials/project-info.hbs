<span class="text-muted text-uppercase">{{category}}</span>

<div class="section-header">
  <div class="col-lg-12 pb-5">
    <h2 class="display-1" data-aos="fade-up" data-aos-delay="100">{{title}}</h2>
  </div>
</div>
<div class="row">
  <div class="col-lg-3 pb-5">
    <div data-aos="fade-up" data-aos-delay="200">
      <ul class="list-unstyled d-flex gap-2 gap-md-5 flex-column flex-md-row">
        <li>
          <h5>Client</h5>
          <p>{{client}}</p>
        </li>
        <li>
          <h5>Year</h5>
          <p>{{year}}</p>
        </li>
      </ul>
    </div>
  </div>
  <div class="col-lg-8 pb-5">
    <div class="fs-5" data-aos="fade-up" data-aos-delay="300">
      <p>{{description}}</p>
    </div>
  </div>
</div>